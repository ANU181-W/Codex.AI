# Backend env example
NODE_ENV=development
PORT=5000

# Database (MySQL Flexible Server)
DATABASE_URL=mysql://user:password@host:3306/codex_ai?sslmode=required

# CORS
CORS_ORIGIN=http://localhost:5173

# OpenAI / Azure OpenAI
OPENAI_API_KEY=xxxx
OPENAI_BASE_URL=https://your-azure-openai.openai.azure.com
OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
OPENAI_API_VERSION=2024-08-01-preview
OPENAI_PROVIDER=azure
MODEL_ROUTING_SMALL=gpt-4o-mini
MODEL_ROUTING_MEDIUM=gpt-4o
MODEL_ROUTING_LARGE=gpt-4o
MAX_TOKENS=1000
TEMPERATURE=0.3

# AI toggles
FORCE_BYPASS_CACHE=false
FORCE_AI=false
ALWAYS_AI=false

# Cache (Redis)
REDIS_URL=redis://localhost:6379
# For Azure Redis with TLS: rediss://your-redis.redis.cache.windows.net:6380

# Azure Blob Storage
USE_BLOB_STORAGE=false
AZURE_STORAGE_ACCOUNT=stcodexai
AZURE_STORAGE_CONTAINER=project-files
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
USE_MANAGED_IDENTITY=false
BLOB_TEXT_PREVIEW_MAX_BYTES=4096

# Observability
APPINSIGHTS_CONNECTION_STRING=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
